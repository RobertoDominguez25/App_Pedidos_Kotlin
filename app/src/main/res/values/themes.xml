<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Examen1Parcial" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Examen1Parcial" parent="Base.Theme.Examen1Parcial" />
    <!-- Estilo específico para botones de cantidad cuadrados -->
    <style name="BotonCantidadCuadrado" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <!-- Esquinas redondeadas -->
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MiTienda.BotonRedondeado</item>
        <!-- Color de fondo y borde -->
        <item name="backgroundTint">@color/color_boton</item>
        <item name="strokeColor">@android:color/black</item>
        <item name="strokeWidth">2.5dp</item>
        <item name="android:elevation">0dp</item>

        <!-- Dimensiones y eliminación de márgenes internos -->
        <item name="android:minWidth">36dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>

        <!-- Centrado exacto y estilo del icono -->
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">@android:color/black</item>
    </style>

    <style name="ShapeAppearance.MiTienda.BotonRedondeado" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>



</resources>